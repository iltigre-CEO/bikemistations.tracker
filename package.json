{
  "name": "bikemi-station-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "browser:install": "playwright install chromium",
    "build": "tsc --project tsconfig.build.json",
    "test:legacy": "vitest run",
    "setup": "node tools/setup.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "playwright": "^1.55.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
